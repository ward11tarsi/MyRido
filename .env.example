# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MYRIDO_SESSION_SECRET: Server-side HMAC secret for signing session & OTP hashes (min 32 chars in production)
MYRIDO_SESSION_SECRET=""

# SUPERADMIN: the ONE mobile number that signs in as SuperAdmin (mobile OTP). Change it to your own number.
MYRIDO_SUPERADMIN_EMAIL=""
MYRIDO_SUPERADMIN_PHONE=""
MYRIDO_SUPERADMIN_PASSWORD=""
MYRIDO_ADMIN_PASSWORD=""

# SUPABASE (ONLY approved central database & auth platform)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# CASHFREE PAYMENTS, KYC & PAYOUTS (ONLY approved payment, KYC, and payout provider)
CASHFREE_ENV="sandbox"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_KYC_CLIENT_ID=""
CASHFREE_KYC_CLIENT_SECRET=""
# Secure ID 2FA public key (Developers > Secure ID > Two-Factor Authentication). Paste the PEM on one line using \n, or set CASHFREE_KYC_PUBLIC_KEY_PATH to the .pem file.
CASHFREE_KYC_PUBLIC_KEY=""
CASHFREE_PAYOUT_CLIENT_ID=""
CASHFREE_PAYOUT_CLIENT_SECRET=""

# FAST2SMS (ONLY approved OTP / SMS provider)
FAST2SMS_API_KEY=""
# Production (India): route "dlt" + approved 6-letter DLT header + Message ID of the approved OTP template
# (template text needs one {#var#} for the OTP). Route "otp" works only if Fast2SMS enables it on your account.
FAST2SMS_ROUTE="dlt"
FAST2SMS_SENDER_ID="MYRIDO"
FAST2SMS_DLT_MESSAGE_ID=""

# EMERGENCY RESPONSE & REPORT DISPATCH
EMERGENCY_DISPATCH_PHONE=""
EMERGENCY_DISPATCH_WEBHOOK_URL=""
REPORT_DISPATCH_WEBHOOK_URL=""

# WHATSAPP NOTIFICATIONS (Meta WhatsApp Cloud API or custom webhook)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_URL=""

# FCM PUSH NOTIFICATIONS (Firebase Cloud Messaging HTTP v1 or push webhook)
FCM_PROJECT_ID=""
FCM_ACCESS_TOKEN=""
FCM_SERVER_KEY=""
PUSH_DISPATCH_WEBHOOK_URL=""

# SENTRY MONITORING (Server & client exception reporting)
SENTRY_DSN=""

# OPTIONAL STAFF 2FA POLICY ("true" to enforce TOTP 2FA enrollment on staff logins)
MYRIDO_REQUIRE_STAFF_2FA="false"



# DATA LAYER
# Set to "true" only if you deliberately run without the single-writer lease (exactly one instance!)
MYRIDO_DISABLE_INSTANCE_LEASE="false"
# Keep writing data/myrido-store.json even when Supabase is configured (debugging only)
MYRIDO_LOCAL_STORE_CACHE="false"

# SIGN-IN: everyone signs in with mobile OTP. Legacy staff password sign-in stays off unless set to "true".
MYRIDO_ENABLE_PASSWORD_LOGIN="false"
